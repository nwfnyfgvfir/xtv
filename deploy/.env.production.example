# 生产机最小 .env 示例（复制为部署目录下的 .env）

TV_IMAGE=ghcr.io/OWNER/tv:latest
HOST_PORT=8000
MEDIA_DIR=./media
DATA_DIR=./data

METATUBE_BASE_URL=https://openai-proxy.caowxj.eu.org
METATUBE_TOKEN=

CORS_ORIGINS=*

# 日志 / 刮削翻译 / 图片代理（可选）
LOG_LEVEL=INFO
DEBUG=false
AUTO_TRANSLATE=true
# google | bing | deepl
TRANSLATE_PROVIDER=google
# Google gtx 代理（可选，可在设置页开关；http(s)/socks5/socks5h）
TRANSLATE_GOOGLE_PROXY=false
# TRANSLATE_GOOGLE_PROXY_URL=http://127.0.0.1:7890
# TRANSLATE_GOOGLE_PROXY_URL=socks5h://127.0.0.1:1080
# DeepL（translate_provider=deepl 时必填）
# TRANSLATE_DEEPL_API_KEY=your-key:fx
# TRANSLATE_DEEPL_API_URL=https://api-free.deepl.com/v2/translate
# TRANSLATE_DEEPL_FREE=true
# TRANSLATE_DEEPL_PROXY=false
# TRANSLATE_DEEPL_PROXY_URL=http://127.0.0.1:7890
# site | metatube | external
IMAGE_PROXY_MODE=site
# IMAGE_EXTERNAL_PROXY_URL=https://wsrv.nl/?url={url}
IMAGE_LOCAL_CACHE=false
# IMAGE_CACHE_MAX_MB=2048
